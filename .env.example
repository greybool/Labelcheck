# Скопируй этот файл в .env и заполни. Файл .env в .gitignore —
# реальный ключ никогда не попадает в репозиторий.
OPENAI_API_KEY=

# Три тира моделей (docs/TZ-LABELCHECK.md, раздел 4.1). Конкретные имена
# фиксируются в День 3 при подключении API:
# CHEAP_MODEL  — query rewriting, генерация ground truth, LLM-judge
# MAIN_MODEL   — вердикты по аспектам
# VISION_MODEL — чтение макета упаковки
CHEAP_MODEL=
MAIN_MODEL=
VISION_MODEL=
