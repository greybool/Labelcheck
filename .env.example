# Скопируй этот файл в .env и заполни. Файл .env в .gitignore —
# реальный ключ никогда не попадает в репозиторий.
OPENAI_API_KEY=

# Три тира моделей (docs/TZ-LABELCHECK.md, раздел 4.1).
# Снапшоты, а не алиасы — чтобы результаты воспроизводились у ревьюеров.
# CHEAP_MODEL  — query rewriting, генерация ground truth, LLM-judge
# MAIN_MODEL   — вердикты по аспектам + обзорный проход vision (карта регионов)
# VISION_MODEL — чтение регионов макета упаковки
CHEAP_MODEL=gpt-5.4-mini-2026-03-17
MAIN_MODEL=gpt-5.4-2026-03-05
VISION_MODEL=gpt-5.4-mini-2026-03-17
